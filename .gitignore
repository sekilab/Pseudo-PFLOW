# =============================================
#  Pseudo-PFLOW .gitignore
# =============================================

# ----- Java build artifacts -----
bin/
target/
out/
build/
*.class

# ----- JARs (use Maven for dependencies) -----
*.jar
!lib/pflowlib.jar
!lib/osmpbf-1.3.3.jar

# ----- IDE / Editor -----
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
.classpath.txt
.factorypath
*.sublime-*

# ----- Claude Code local settings -----
.claude/
CLAUDE.md

# ----- Maven wrapper (optional, regenerable) -----
.mvn/

# ----- Log files -----
*.log
hs_err_pid*
replay_pid*

# ----- OS files -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Temp / backup files -----
*.tmp
*.swp
*.bak
*.orig
*.rej
*.backup
compile_*_args.txt
*edit-log.txt

# ----- Large binary data files -----
*.bin
*.dat
*.raster

# ----- Compressed / archive files -----
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ----- Simulation output (large, regenerable) -----
data/output/

# ----- Jupyter / Python -----
.ipynb_checkpoints/
__pycache__/
*.py[cod]

# ----- Generated docs -----
*.pdf
*.xlsx

# ----- Local compile scripts (contain hardcoded machine paths) -----
# Run scripts live in ../scripts/ and are tracked there
compile_local.*
*.ps1
*.sh
*.bat

# ----- Config test variants (local experiments) -----
*.properties.test_*

# ----- Stray JARs at project root -----
osmpbf-*.jar

# ----- Environment files -----
.env
bin_fresh/

# ----- Runtime working dirs (LOCAL-ONLY, regenerable) -----
output/
logs/

# ----- Local scratch scripts (leading underscore = local-only) -----
_*.bat
_*.sh
