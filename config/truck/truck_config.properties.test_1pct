# ============================================================================
# TRUCK ABM CONFIGURATION - ENHANCED WITH METROPOLITAN MODES
# Version 2.0 - Inter/Intra-Metropolitan Operations
# ============================================================================

# ============================================================================
# METROPOLITAN CONFIGURATION
# ============================================================================

# Operational mode: INTRA or INTER
# INTRA: Trucks operate within single metropolitan area
# INTER: Trucks make round trips between metropolitan areas
metro.mode=INTRA

# Primary metropolitan area
# Options: TOKYO, NAGOYA, OSAKA, FUKUOKA, SAPPORO
metro.primary=TOKYO

# Secondary metropolitan area (only for INTER mode)
# Example: TOKYO ↔ NAGOYA corridor
metro.secondary=NAGOYA

# Inter-metropolitan trip probability by truck type (only for INTER mode)
metro.inter.longhaul.prob=0.60
metro.inter.urban.prob=0.25
metro.inter.delivery.prob=0.10

# ============================================================================
# DATASET CONFIGURATION
# ============================================================================

# Directory containing MFS JSON files for validation
# Points to JSON files: file08_regional_flows.json, file18_vehicle_sizes.json, etc.
datasets.directory=N:/PFLOW-test

# MFS Validation Settings
validation.mfs.enabled=true
validation.mfs.tolerance.pct=10.0

# Enable dataset-based calibration
datasets.calibration.enabled=true

# Use dataset values for initialization
datasets.use.vehicle.distribution=true
datasets.use.trip.generation=true
datasets.use.flow.patterns=true

# POI System Configuration
datasets.use.poi.destinations=true
datasets.poi.mode=from_csv
datasets.poi.establishment.file=facilities/establishments.csv

# O-D Matrix Configuration
datasets.use.mfs.od.matrix=true
datasets.od.matrix.file=flows/od_volume.csv
datasets.zone.mapping.file=zones/mapping.csv

# Generation-Attraction Balance
datasets.use.ga.balance=true
datasets.ga.targets.file=flows/ga_targets.csv

# ============================================================================
# FLEET CONFIGURATION - MLIT ALIGNMENT
# ============================================================================

# SCALING TO NATIONAL STATISTICS (MLIT)
#
# MLIT Definition (実働率 = operating rate):
#   実働率 = 実働延日車 / 実在延日車
#   (vehicles that ran at least once / total registered vehicles)
#
# National Statistics:
#   - Total registered trucks (MLIT): 2,530,000 vehicles
#   - Operating rate (MLIT 実働率): 0.567 (56.7%)
#   - Daily active fleet: 2,530,000 × 0.567 = 1,434,510 trucks
#
# Scale Factor: 4.387x from original MFS baseline (327,108 → 1,434,510)
#
# Total registered fleet (MLIT)
truck.registered.fleet.size=2530000
# MLIT operating rate (reference only)
truck.operating.rate=0.567
# Daily active trucks (simulated) - TESTING 1% SCALE
truck.fleet.size=14345

# LEGACY MFS BASELINE (for reference)
# truck.fleet.size=327108
# truck.operating.rate=0.98

# TESTING MODE (10% scale for validation)
# truck.fleet.size=143451

# ============================================================================
# TRUCK TYPE DISTRIBUTION
# ============================================================================

# Truck type distribution (from MFS File 18 vehicle counts)
# CORRECTED based on vehicle size → truck type mapping:
# - DELIVERY: Light + 30% Small = 121,061/327,108 = 37.01%
# - MIXED: 70% Small + 50% Medium = 93,187/327,108 = 28.49%
# - LONG_HAUL: Heavy + 50% Medium = 112,860/327,108 = 34.50%
truck.type.delivery.prob=0.3701
truck.type.mixed.prob=0.2849
truck.type.longhaul.prob=0.3450

# Familiar area radius for DELIVERY type (km)
# Reduced from 3.0 to 0.5 to match MFS intra-zone ratio of 20.7%
# Phase 3: O-D matrix has 19.2% intra-zone, simulation was at 46.5% with radius=3.0
truck.type.delivery.familiar.radius.km=0.5

# Vehicle size preferences by truck type (light, small, medium, heavy)
# CORRECTED from File 18 analysis:
# DELIVERY: Light (76.8%) + Small (23.2%)
truck.type.delivery.vehicle.probs=0.768,0.232,0.0,0.0
# MIXED: Small (70.4%) + Medium (29.6%)
truck.type.mixed.vehicle.probs=0.0,0.704,0.296,0.0
# LONG_HAUL: Heavy (75.6%) + Medium (24.4%)
truck.type.longhaul.vehicle.probs=0.0,0.0,0.244,0.756

# ============================================================================
# TRIP CONFIGURATION
# ============================================================================

# Trips per truck (Gaussian distribution) - Global defaults
truck.trips.average=8
truck.trips.min=5
truck.trips.max=15
truck.trips.stddev=2.0

# Trips per day by truck type (MFS-calibrated to achieve 3.71 movements/truck)
# Target: 1,215,097 movements / 327,108 trucks = 3.71 movements/truck
# With DELIVERY=37%, MIXED=28.5%, LONG_HAUL=34.5%:
# Updated calculation: 0.37×14 + 0.285×10 + 0.345×4 = 5.18+2.85+1.38 = 9.41 base trips/truck
# After G-A balance constraints (79% achievement), expect ~7.4 total trips → ~4.4 deliveries/truck
# Work hour analysis confirms feasibility:
#   DELIVERY: 14 trips × 0.90 hrs/trip = 12.6 hrs (safe within 16 hr shift)
#   MIXED: 10 trips × 1.42 hrs/trip = 14.2 hrs (safe within 16 hr shift)
#   LONG_HAUL: 4 trips × 7.05 hrs/trip = 28.2 hrs (exceeds, but some make fewer trips)
truck.trips.DELIVERY=14
truck.trips.MIXED_OPERATION=10
truck.trips.LONG_HAUL=4

# ============================================================================
# VEHICLE SIZE CONFIGURATION
# ============================================================================

# Vehicle capacities (tons) - Calibrated to MFS survey reality
# Based on actual Japanese truck classifications and MFS data
vehicle.capacity.large.tons=20.0
vehicle.capacity.medium.tons=8.0
vehicle.capacity.small.tons=5.0
vehicle.capacity.light.tons=2.0

# ============================================================================
# ZONE CONFIGURATION
# ============================================================================

# Zone definition file (CSV)
# Will load metropolitan-specific file based on metro.primary
# NOTE: This is overridden by simulation.mode (INTRA/INTER/DUAL uses zones.file.intra/inter)
zones.file=zones/intra.csv

# Simulation mode: INTRA_METROPOLITAN, INTER_METROPOLITAN, or DUAL
# INTRA_METROPOLITAN: Within 50km of Tokyo center (37 zones)
# INTER_METROPOLITAN: Beyond 50km from Tokyo + long-haul regions (34 zones)
# DUAL: Run BOTH for complete MFS validation (71 total zones)
simulation.mode=DUAL

# Zone files for each simulation mode
# Intra-metropolitan (<50km): MFS zones 1-21, 25-33, 38-44 (Tokyo core + near suburbs)
#   Includes: Tokyo 23 wards, Yokohama, Kawasaki, Sagamihara, near Kanagawa coast,
#             south/central Saitama, west/central Chiba
# Inter-metropolitan (>50km): MFS zones 22-24, 34-37, 45-71 (far regions + long-haul)
#   Includes: Far Kanagawa coast, north Saitama, east/south Chiba, Ibaraki, Gunma,
#             Tochigi, Tokyo Islands, and long-haul regions (Hokkaido, Osaka, etc.)
zones.file.intra=zones/intra.csv
zones.file.inter=zones/inter.csv

# ============================================================================
# TIME PERIOD CONFIGURATION
# ============================================================================

# Time periods for attractiveness calculation
# Period 1: Morning (warehouse/construction peak)
time.period.1.start=06:00
time.period.1.end=12:00

# Period 2: Afternoon (retail/residential peak)
time.period.2.start=12:00
time.period.2.end=18:00

# Period 3: Night (restricted, automatically calculated)
# 18:00-06:00

# ============================================================================
# ATTRACTIVENESS COEFFICIENTS
# ============================================================================

# Zone attractiveness formula:
# A_j = (β1·w_warehouses + β2·w_retail + β3·w_construction + β4·w_residential) × m_t

attractiveness.beta1.warehouses=1.0
attractiveness.beta2.retail=0.8
attractiveness.beta3.construction=0.7
attractiveness.beta4.residential=0.6

# ============================================================================
# LOADING/UNLOADING TIMES
# ============================================================================

# Loading time (minutes, Gaussian distribution)
loading.time.average.minutes=20.0
loading.time.stddev.minutes=5.0

# Unloading time (minutes, Gaussian distribution)
unloading.time.average.minutes=15.0
unloading.time.stddev.minutes=5.0

# ============================================================================
# SHIFT CONFIGURATION
# ============================================================================

# Shift duration (hours, Gaussian distribution)
shift.duration.min=12
shift.duration.max=20
shift.duration.average=16
shift.duration.stddev=2.0

# Shift start times (staggered)
# Based on Tokyo MFS temporal patterns
shift.start.1.time=05:00
shift.start.1.probability=0.40

shift.start.2.time=08:00
shift.start.2.probability=0.45

shift.start.3.time=13:00
shift.start.3.probability=0.15

# ============================================================================
# ROUTING CONFIGURATION
# ============================================================================

# Average speed (km/h)
routing.average.speed.kmh=45.0
routing.highway.speed.kmh=100.0

# Break time per trip (seconds)
routing.break.time.seconds=180.0

# ============================================================================
# GEOGRAPHY CONFIGURATION - TOKYO
# ============================================================================

# Tokyo Metropolitan Area bounds (auto-loaded from MetropolitanConfig)
geography.tokyo.min.lon=139.3
geography.tokyo.max.lon=140.0
geography.tokyo.min.lat=35.5
geography.tokyo.max.lat=35.9

# Earth radius for distance calculations
geography.earth.radius.km=6371.0

# ============================================================================
# DISTANCE CALCULATION
# ============================================================================

# Manhattan distance factor (accounts for road network vs straight-line distance)
# Calibrated for reduced empty trip model (7% empty, professor feedback)
distance.manhattan.factor=2.25

# ============================================================================
# EMPTY TRIP CONFIGURATION
# ============================================================================

# Enable empty repositioning trips
use.empty.trips=true

# Empty trip probability (professor feedback: trucks are costly to operate empty)
# Target 5-10% empty ratio. Calculation: 0.075 / 0.925 ≈ 0.08
empty.trip.probability=0.08

# Minimum threshold for empty trip (km)
empty.trip.threshold.km=0.5

# ============================================================================
# CARGO WEIGHT GENERATION
# ============================================================================

# Cargo weight distribution (Gamma distribution)
# Calibrated to match MFS baseline: avg 5.28 tons/delivery
# Accounting for commodity loading rates (~0.65 average)
# Gamma: shape=2.0, scale=4.5 → mean=9.0 tons raw
cargo.weight.mean.tons=9.0
cargo.weight.stddev.tons=4.0
cargo.weight.gamma.shape=2.0
cargo.weight.gamma.scale=3.8

# ============================================================================
# RANDOM SEED
# ============================================================================

# Random seed for reproducibility (set to system time for random: -1)
random.seed=42

# ============================================================================
# EXPORT CONFIGURATION
# ============================================================================

# Date/time formats for exports
export.datetime.format=yyyy-MM-dd HH:mm:ss
export.time.format=HH:mm:ss

# Output directory
export.output.dir=data/output/truck

# Enable metrics export
export.metrics.enabled=true

# ============================================================================
# VALIDATION CONFIGURATION
# ============================================================================

# Enable MFS validation
validation.enabled=true

# Validation tolerance levels
validation.tolerance.tight=0.02
validation.tolerance.normal=0.05
validation.tolerance.loose=0.10
